# Optional API tokens. Leave blank to skip a provider.
# Example: github_pat_xxxxxxxxxxxxxxxxxxxx
GITHUB_API_TOKEN=
# Example: glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_API_TOKEN=
# Example: xxxxxxxxxxxxxxxxxxxx
CODEBERG_TOKEN=
# Example: ATBBxxxxxxxxxxxxxxxxxxxx
BITBUCKET_API_TOKEN=
# Example: user@example.org
BITBUCKET_EMAIL=

# Classifier model files. Leave blank to use the models installed with somef.
# Example: /usr/local/lib/python3.11/site-packages/somef/models/description.p
SOMEF_DESCRIPTION_MODEL=
# Example: /usr/local/lib/python3.11/site-packages/somef/models/invocation.p
SOMEF_INVOCATION_MODEL=
# Example: /usr/local/lib/python3.11/site-packages/somef/models/installation.p
SOMEF_INSTALLATION_MODEL=
# Example: /usr/local/lib/python3.11/site-packages/somef/models/citation.p
SOMEF_CITATION_MODEL=

# RDF/base metadata configuration.
# Example: https://w3id.org/okn/i/
SOMEF_BASE_URI=
# Example: 1000
SOMEF_DOWNLOAD_LIMIT_MB=1000
